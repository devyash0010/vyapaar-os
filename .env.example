# Vyapaar OS - Environment Configuration Template
# Copy this file to .env and adjust values for your environment

# Project & Server
PROJECT_NAME="Vyapaar OS API"
VERSION="1.0.0"
PORT=8000
ENVIRONMENT=production

# Database & Cache
MONGODB_URL=mongodb://localhost:27017/vyapaar_core
DATABASE_NAME=vyapaar_core
REDIS_URL=redis://localhost:6379

# Security & Authentication
# Generate a secure random string (e.g. openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_32_char_secret_key_in_production
JWT_SECRET=change_this_to_a_secure_random_32_char_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS & Host Security (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api

# Optional AI / LLM Integrations
OPENAI_API_KEY=

# n8n Automation Workflows
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=your_n8n_encryption_key

